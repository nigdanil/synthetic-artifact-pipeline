# Runtime, caches and local development
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
build/
dist/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Credentials (never commit real secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.*
secrets.*

# Raw data and any derivatives — no exceptions for actual photos/labels
/data/raw/**
!/data/raw/README.md
/data/work/**
!/data/work/.gitkeep
/data/pilot/**
!/data/pilot/.gitkeep
/datasets/
/raw/
/private/
/outputs/**
!/outputs/.gitkeep
/reports/**
!/reports/.gitkeep

# Personal workflow, vendor mappings and internal project reference notes
/workflows/existing/**
!/workflows/existing/README.md
/configs/class_mappings/**
!/configs/class_mappings/README.md
/docs/reference/
/docs/internal/
/docs/private/
/План.md

# Defense in depth: ban dataset assets anywhere by default
*.seg
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tif
*.tiff
*.gif
*.mp4
*.mov
*.wav
*.mp3
*.zip
*.7z
*.rar
*.tar
*.gz
*.csv
*.tsv
*.jsonl
*.ndjson
*.parquet
*.sqlite
*.sqlite3
*.db
*.pt
*.pth
*.ckpt
*.safetensors
